{
  "headers": [
    {
      "source": "/OnlineCRM-Gateway.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"OnlineCRM-Gateway.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/api/telephony/download-apk",
      "destination": "/OnlineCRM-Gateway.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/OnlineCRM-Gateway.apk",
      "destination": "/OnlineCRM-Gateway.apk"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://online-crm.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
