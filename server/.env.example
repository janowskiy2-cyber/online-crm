# Database Connection (Neon Tech PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-example.pooler.aws.neon.tech/neondb?sslmode=require"

# JWT Security
JWT_SECRET="generate_a_random_secure_secret_key_here"

# Master Admin Key
ADMIN_MASTER_KEY="22222222"

# Server Port
PORT=5000

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Telegram MTProto (Optional custom credentials)
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""

# Gemini AI (Optional)
GEMINI_API_KEY=""
