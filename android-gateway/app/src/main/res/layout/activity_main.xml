<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090d16"
    android:padding="16dp">

    <!-- Header Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0e1424"
        android:padding="16dp"
        android:elevation="4dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OnlineCRM GSM Gateway"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟢 GSM Шлюз активний (SIM 1)"
            android:textColor="#10b981"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvManagerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Менеджер: Адміністратор"
            android:textColor="#94a3b8"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Configuration Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0e1424"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Адреса сервера CRM:"
            android:textColor="#94a3b8"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etServerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="https://online-crm-alpha.vercel.app"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:background="#080c16"
            android:padding="10dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ID Менеджера (з профілю CRM):"
            android:textColor="#94a3b8"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etUserId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="usr-admin"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:background="#080c16"
            android:padding="10dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSaveConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Зберегти налаштування"
            android:backgroundTint="#3b82f6"
            android:textColor="#ffffff" />
    </LinearLayout>

    <!-- Open CRM Button -->
    <Button
        android:id="@+id/btnOpenCrm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Відкрити інтерфейс CRM"
        android:backgroundTint="#6366f1"
        android:textColor="#ffffff"
        android:layout_marginBottom="12dp" />

    <!-- Embedded CRM WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

</LinearLayout>
